# ================================================
# SOFTLINE INFOTECH E-COMMERCE CONFIGURATION
# ================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ================================================

# ============ DATABASE CONFIGURATION ============
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=soft_db

# ============ APPLICATION CONFIGURATION ============
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_key_here

# Set to False in production
DEBUG=False

# ============ ADMIN CREDENTIALS ============
# Change these immediately after first login!
ADMIN_USERNAME=softline_admin
ADMIN_PASSWORD=change_this_password

# ============ WHATSAPP CONFIGURATION ============
# Your WhatsApp Business Number (without +)
# Format: 91XXXXXXXXXX (India country code + 10-digit number)
# Example: 919876543210
WHATSAPP_BUSINESS_NUMBER=919409415293

# ============ EMAIL (OPTIONAL - For future use) ============
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_EMAIL=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
